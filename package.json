{
  "name": "paperless-dock",
  "version": "1.0.0",
  "private": true,
  "description": "A digital bookstore and personal reading platform.",
  "main": "index.js",
  "scripts": {
    "dev:web": "npm run dev --workspace=@paperless-dock/web",
    "dev:api": "npm run dev --workspace=@paperless-dock/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces  --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
