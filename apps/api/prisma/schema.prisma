generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Roles that a user can have.
enum UserRole {
  CUSTOMER
  ADMIN
}

// 2. Possible publication states of a book.
enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 3. Possible states of an order.
enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// 4. Possible payment states of an order.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// 5. Payment providers.
enum PaymentProvider {
  RAZORPAY
}

// 6. Possible states of an individual payment attempt.
enum PaymentAttemptStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

// 7. Processing states of a payment webhook event.
enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// 8. Publication states of a review.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// 9. Customer and administrator accounts.
model User {
  id              String            @id @default(uuid())
  name            String
  email           String            @unique
  passwordHash    String
  role            UserRole          @default(CUSTOMER)
  avatar          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  orders          Order[]
  libraryItems    LibraryItem[]
  readingProgress ReadingProgress[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cart            Cart?
  cartMigrations  CartMigration[]
}

// 10. Main bibliographic information for a book.
model Book {
  id               String            @id
  title            String
  slug             String            @unique
  description      String            @db.Text
  coverImage       String?
  price            Decimal           @db.Decimal(10, 2)
  currency         String            @default("INR") @db.VarChar(3)
  publicationDate  DateTime?
  language         String            @default("en")
  pageCount        Int?
  isbn             String?           @unique
  publisherId      String?
  publisher        Publisher?        @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  contentReference String?
  status           BookStatus        @default(DRAFT)
  rating           Float             @default(0)
  reviewCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  authors          BookAuthor[]
  categories       BookCategory[]
  orderItems       OrderItem[]
  libraryItems     LibraryItem[]
  readingProgress  ReadingProgress[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]

  @@index([status])
  @@index([title])
}

// 11. Author profiles.
model Author {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  biogarphy String?      @db.Text
  photo     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  books     BookAuthor[]

  @@index([name])
}

// 12. Connects books and authors in a many-to-many relationship.
model BookAuthor {
  bookId   String
  authorId String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
}

// 13. Reusable book categories.
model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?        @db.Text
  books       BookCategory[]
  createdAt   DateTime       @default(now())
}

// 14. Connects books and categories in a many-to-many relationship.
model BookCategory {
  bookId     String
  categoryId String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([categoryId])
}

// 15. Publisher information.
model Publisher {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  books     Book[]
}

// 16. Stores customer orders.
model Order {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  subtotal        Decimal          @db.Decimal(10, 2)
  currency        String           @default("INR") @db.VarChar(3)
  status          OrderStatus      @default(PENDING)
  paymentStatus   PaymentStatus    @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           OrderItem[]
  libraryItems    LibraryItem[]
  paymentAttempts PaymentAttempt[]

  @@index([userId])
  @@index([status])
}

// 17. Individual books within an order.
model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  titleSnapshot String
  priceSnapshot Decimal  @db.Decimal(10, 2)
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())

  @@unique([orderId, bookId])
  @@index([bookId])
}

// 18. Tracks individual payment attempts for an order.
model PaymentAttempt {
  id                 String               @id @default(uuid())
  orderId            String
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           PaymentProvider      @default(RAZORPAY)
  providerOrderId    String               @unique
  providerPaymentId  String?              @unique
  amount             Decimal              @db.Decimal(10, 2)
  currency           String               @default("INR") @db.VarChar(3)
  status             PaymentAttemptStatus @default(CREATED)
  failureCode        String?
  failureDescription String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  capturedAt         DateTime?

  @@index([orderId])
  @@index([status])
}

// 19. Records incoming payment webhook events.
model PaymentWebhookEvent {
  id              String                  @id @default(uuid())
  provider        PaymentProvider         @default(RAZORPAY)
  providerEventId String
  eventType       String
  payload         Json
  status          WebhookProcessingStatus @default(RECEIVED)
  processingToken String?
  processingError String?                 @db.Text
  processedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
}

// 20. Represents a book that a user can access in their library.
model LibraryItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchasedAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([orderId])
}

// 21. Stores the latest saved reading location for each user and book.
model ReadingProgress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  position   String   @default("start")
  percentage Float    @default(0)
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, lastReadAt])
}

// 22. Stores customer reviews of books.
model Review {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updateAt  DateTime     @updatedAt

  @@unique([userId, bookId])
  @@index([bookId, status])
}

// 23. Stores books that users have saved to their wishlists.
model WishlistItem {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId   String
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
}

// 24. Stores a user's shopping cart.
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 25. Stores individual books in a shopping cart.
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bookId])
  @@index([bookId])
}

// 26. Stores Express authentication sessions.
model Session {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// 27. Records completed guest-cart migrations for each user.
model CartMigration {
  id          String   @id @default(uuid())
  userId      String
  migrationId String
  payloadHash String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, migrationId])
  @@index([userId])
}
